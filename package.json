{
  "name": "raw2md-site",
  "private": true,
  "version": "0.0.0",
  "description": "Static site of raw2md, built with Astro.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "lint:js": "eslint .",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.{css,astro}\"",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint:js && npm run lint:css && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
