{
  "name": "raw2md-site",
  "private": true,
  "version": "0.0.0",
  "description": "Static site of raw2md, built with Astro.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "lint:js": "eslint .",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.{css,astro}\"",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "check:dist": "node scripts/check-dist.ts",
    "check:html": "html-validate dist",
    "check:links": "lychee --offline --include-fragments --index-files index.html --root-dir dist dist",
    "check:lighthouse": "lhci autorun",
    "check": "npm run typecheck && npm run lint:js && npm run lint:css && npm run format:check && npm run test && npm run build && npm run check:dist && npm run check:html && npm run check:links && npm run check:lighthouse"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "astro": "7.3.8",
    "github-slugger": "2.0.0",
    "katex": "0.18.9",
    "satteri": "0.10.5",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "html-validate": "11.16.2",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
