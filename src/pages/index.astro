---
const title = 'raw2md';
const description =
  'Command-line tool that converts PDF, DOCX, DjVu and scans to clean Markdown.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>
      <a href="https://github.com/MikeDolg/raw2md">GitHub</a>
      <a href="https://pypi.org/project/raw2md/">PyPI</a>
    </p>
  </body>
</html>
