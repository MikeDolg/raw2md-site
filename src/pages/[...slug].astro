---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Toc from '../components/Toc.astro';
import Base from '../layouts/Base.astro';
import { articleLd, ogImagePath, trail, twinPath } from '../seo';
import { byManifest, sitePages } from '../site';

export const getStaticPaths = (async () => {
  const pages = byManifest(await getCollection('pages'));
  return pages
    .filter((page) => page.id !== 'index')
    .map((page) => ({ params: { slug: page.id }, props: { page, pages } }));
}) satisfies GetStaticPaths;

interface Props {
  page: CollectionEntry<'pages'>;
  /** Every page, in the order of the manifest. */
  pages: CollectionEntry<'pages'>[];
}

/** The route one level up: `/docs/` for `/docs/post/`, `/` for `/install/`. */
function parentRoute(route: string): string | undefined {
  if (route === '/') return undefined;
  return route.replace(/[^/]+\/$/, '');
}

const { page, pages } = Astro.props;
const { Content, headings } = await render(page);
const { title, route, version, kind, notice } = page.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = toc.filter((h) => h.depth === 2).length >= 2;

// A page under a section steps through its siblings, after the section page.
const parent = parentRoute(route);
const parentPage = pages.find((p) => p.data.route === parent);
const group =
  parentPage && parent !== '/' && kind !== 'contents'
    ? [
        parentPage,
        ...pages.filter(
          (p) => parentRoute(p.data.route) === parent && p.data.kind === kind,
        ),
      ]
    : [];
const at = group.findIndex((p) => p.id === page.id);
const prev = at > 0 ? group[at - 1] : undefined;
const next = at >= 0 ? group[at + 1] : undefined;
const children = pages.filter(
  (p) => parentRoute(p.data.route) === route && p.data.kind !== 'part',
);
const listTitle = children.some((p) => p.data.kind === 'contents')
  ? 'Read by part'
  : 'Documents';

if (!Astro.site) throw new Error('astro.config.mjs: no site');
const all = await sitePages();
const info = all.find((p) => p.id === page.id);
if (!info) throw new Error(`${route}: not in the site pages`);
const crumbs = trail(info, all).slice(1, -1);
const pageTitle =
  kind === 'doc' || !parentPage ? title : `${title} · ${parentPage.data.title}`;
---

<Base
  title={`${pageTitle} · raw2md`}
  description={page.data.summary}
  route={route}
  version={version}
  image={ogImagePath(page)}
  type="article"
  twin={twinPath(page)}
  jsonLd={articleLd(info, all, Astro.site)}
  noindex={kind !== 'doc'}
>
  <div class:list={['wrap', 'doc', { 'doc-single': !hasToc }]}>
    <main id="main" class="doc-main">
      <div class="crumbs">
        <nav aria-label="Breadcrumb">
          <ol>
            {crumbs.map((crumb) => (
              <li>
                <a href={crumb.route}>{crumb.title}</a>
              </li>
            ))}
            <li>
              <span aria-current="page">{title}</span>
            </li>
          </ol>
        </nav>
        <a class="md-link" href={twinPath(page)}>
          View as Markdown
        </a>
      </div>
      <article class="prose">
        <h1>{title}</h1>
        {notice && <div class="notice" role="note" set:html={notice} />}
        {hasToc && (
          <details class="toc-mobile">
            <summary>On this page</summary>
            <Toc headings={toc} />
          </details>
        )}
        <Content />
        {children.length > 0 && (
          <>
            <h2 class="list-title">{listTitle}</h2>
            <ul class="doc-list">
              {children.map((child) => (
                <li>
                  <a href={child.data.route}>{child.data.title}</a>
                  <p>{child.data.summary}</p>
                </li>
              ))}
            </ul>
          </>
        )}
      </article>
      {(prev || next) && (
        <nav class="pager" aria-label="Previous and next">
          {prev && (
            <a href={prev.data.route} rel="prev">
              <span>← Previous</span>
              <strong>{prev.data.title}</strong>
            </a>
          )}
          {next && (
            <a class="next" href={next.data.route} rel="next">
              <span>Next →</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </nav>
      )}
    </main>
    {hasToc && (
      <aside class="toc" aria-labelledby="toc-title">
        <p class="toc-title" id="toc-title">
          On this page
        </p>
        <Toc headings={toc} />
      </aside>
    )}
  </div>
</Base>
